# Copy to `.env` and fill in. Required for the backend (app.py) to start.

# LLM used for structured field extraction and the document Q&A agent
# (Groq, Llama 3.3 70B). app.py raises at import if this is missing.
GROQ_API_KEY=

# State store + Celery broker/backend (a single Redis URL is reused for both)
REDIS_URL=

# Azure Blob Storage — uploaded documents are staged here for OCR
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=kyc-image

# Azure AI Document Intelligence (Form Recognizer) — OCR
AZURE_FORM_RECOGNIZER_ENDPOINT=
AZURE_FORM_RECOGNIZER_KEY=

# Optional — server port (defaults to 5000)
# PORT=5000
